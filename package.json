{
  "name": "@imsankz/seoflow",
  "version": "0.2.1",
  "description": "AI-powered SEO pipeline — content audit, keyword research, internal linking, image injection, content generation, publishing",
  "type": "module",
  "bin": {
    "seoflow": "./dist/bin/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imsankz/seoflow.git"
  },
  "homepage": "https://github.com/imsankz/seoflow#readme",
  "bugs": {
    "url": "https://github.com/imsankz/seoflow/issues"
  },
  "author": "Sankalp (https://github.com/imsankz)",
  "exports": {
    ".": "./dist/index.js",
    "./pipeline": "./dist/pipeline/steps.js",
    "./*": "./dist/*.js"
  },
  "files": [
    "dist",
    ".claude-plugin",
    "hooks",
    "install.sh",
    "install.ps1",
    "uninstall.sh",
    "uninstall.ps1",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "prepublishOnly": "node build.mjs",
    "seoflow": "npx tsx run.ts",
    "seoflow:init": "npx tsx run.ts init",
    "seoflow:dry": "npx tsx run.ts --dry-run",
    "seoflow:audit": "npx tsx run.ts audit",
    "seoflow:status": "npx tsx run.ts status",
    "seoflow:generate": "npx tsx run.ts generate",
    "seoflow:publish": "npx tsx run.ts publish",
    "seoflow:cluster": "npx tsx run.ts cluster",
    "seoflow:brief": "npx tsx run.ts brief",
    "seoflow:learn": "npx tsx run.ts learn",
    "seoflow:orchestrate": "npx tsx run.ts orchestrate",
    "seoflow:brain": "npx tsx run.ts brain",
    "seoflow:vault": "npx tsx run.ts vault",
    "install:repo": "bash ./install.sh",
    "uninstall:repo": "bash ./uninstall.sh",
    "test": "npx tsx --test tests/*.test.ts",
    "test:unit": "npx tsx --test tests/*.test.ts",
    "test:integration": "npx tsx --test tests/integration.test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "seo",
    "pipeline",
    "content-optimization",
    "keyword-research",
    "audit",
    "ai-seo",
    "programmatic-seo",
    "gsc",
    "search-console",
    "schema-org",
    "internal-linking",
    "content-audit",
    "neuronwriter",
    "mdx",
    "frontmatter",
    "technical-seo",
    "eeat",
    "ai-content"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  }
}
