# ─── AI Providers (at least one required) ─────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key
GEMINI_API_KEY=your_gemini_key
OPENROUTER_API_KEY=your_openrouter_key

# Which provider to prefer: "claude", "openrouter", or "gemini" (default: gemini)
AI_PROVIDER=gemini

# AI Citation Tracker (`seoflow citations` / `seoflow sov`) reuses
# GEMINI_API_KEY / OPENROUTER_API_KEY above — no extra keys required.
# With OPENROUTER_API_KEY it probes ChatGPT/Gemini/Perplexity via OpenRouter;
# with only GEMINI_API_KEY it probes the Gemini brand via the direct API.

# ─── Keyword Research ─────────────────────────────────────────────────────────
AHREFS_API_KEY=your_ahrefs_key
SEMRUSH_API_KEY=your_semrush_key

# ─── Google Search Console ─────────────────────────────────────────────────────
# SeoFlow uses Application Default Credentials (ADC) for live GSC data.
# No key needed here — auth is handled by gcloud CLI on your machine.
#
# One-time setup:
#   gcloud auth application-default login \
#     --scopes=https://www.googleapis.com/auth/webmasters.readonly
#
# The site property is read from seoflow.config.json → "siteUrl".
# Override here if your GSC property uses "sc-domain:" format:
#   GSC_SITE_URL=sc-domain:yourdomain.com
#
# GSC_SITE_URL=

# ─── SEO Data ─────────────────────────────────────────────────────────────────
NEURONWRITER_API_KEY=your_neuronwriter_key
NEURONWRITER_PROJECT_ID=your_project_id

# ─── PageSpeed Insights / CrUX (optional, free) ───────────────────────────────
# Restores real PSI/LCP/CLS/INP data in `seoflow audit <url>` reports.
# Enable "PageSpeed Insights API" + "Chrome UX Report API" in Google Cloud,
# create an API key, and restrict it to those two APIs.
# Alternative: add PAGESPEED_API_KEY to ~/.config/seoflow/google-api.json
# (GOOGLE_API_KEY is accepted as a legacy alias).
PAGESPEED_API_KEY=your_google_api_key

# ─── Image Sources (optional) ─────────────────────────────────────────────────
PEXELS_API_KEY=your_pexels_key
UNSPLASH_API_KEY=your_unsplash_key
